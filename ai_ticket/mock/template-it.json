      "key": "device_no",
      "label": "设备编号",
      "type": "text",
      "required": true,
      "options": null,
      "pattern": "^(PC|PR)-\\d{4}$"
    },
    {
      "key": "fault_type",
      "label": "故障类型",
      "type": "enum",
      "required": true,
      "options": ["硬件故障", "软件故障", "网络问题", "账号权限", "其他"],
      "pattern": null
    },
    {
      "key": "impact_scope",
      "label": "影响范围",
      "type": "enum",
      "required": true,
      "options": ["仅本人", "整个部门", "全公司"],
      "pattern": null
    },
    {
      "key": "urgent",
      "label": "是否影响当前正在进行的业务",
      "type": "boolean",
      "required": false,
      "options": null,
      "pattern": null
    },
    {
      "key": "first_seen",
      "label": "问题最早出现日期",
      "type": "date",
      "required": false,
      "options": null,
      "pattern": null
    },
    {
      "key": "screenshot",
      "label": "报错截图",
      "type": "image",
      "required": false,
      "options": null,
      "pattern": null

      "key": "order_id",
      "label": "订单号",
      "type": "text",
      "required": true,
      "options": null,
      "pattern": "^\\d{8,20}$"
    },
    {
      "key": "reason",
      "label": "原因",
      "type": "enum",
      "required": true,
      "options": ["尺码不合适", "质量问题", "发错货", "其他"],
      "pattern": null
    },
    {
      "key": "worn",
      "label": "是否已穿着或洗涤",
      "type": "boolean",
      "required": false,
      "options": null,
      "pattern": null
